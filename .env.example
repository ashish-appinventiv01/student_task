NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Required. No default. Number from 0 to 100. A subject average at or above this is a pass.
PASS_PERCENTAGE=40

# Required. No default. Format YYYY-YY, where the second year is the first year plus one.
ACADEMIC_YEAR=2026-27

# Signs access tokens. Defaults to a development value when unset.
JWT_SECRET=change-me

# Mark submissions allowed per user per 10 minutes. Positive integer. Defaults to 60.
MARKS_RATE_LIMIT_MAX=60

# Comma-separated http(s) origins. "*" is rejected: any website could read the API from a user's browser.
CORS_ORIGINS=http://localhost:3000
